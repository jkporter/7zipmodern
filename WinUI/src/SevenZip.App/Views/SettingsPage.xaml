<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevenZip.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" />
                <tk:SettingsCard Header="App theme">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Description="Mica Alt is recommended for windows with tabs." Header="Window material">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind BackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Mica" />
                        <ComboBoxItem Content="Mica Alt" />
                        <ComboBoxItem Content="Acrylic" />
                    </ComboBox>
                </tk:SettingsCard>

                <!-- Extracting -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Extracting" />
                <tk:SettingsCard Description="Creates a folder named after the archive only when the archive doesn't already have a single top-level folder." Header="Smart extraction folder">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F4;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.SmartExtractFolder, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Show extracted files in File Explorer">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED25;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.OpenFolderAfterExtract, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="When a file already exists">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C8;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind OverwriteIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Ask me" />
                        <ComboBoxItem Content="Replace it" />
                        <ComboBoxItem Content="Skip it" />
                        <ComboBoxItem Content="Keep both" />
                        <ComboBoxItem Content="Rename the existing file" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Description="Files extracted from a downloaded archive keep its security zone, so SmartScreen and Office Protected View still protect you." Header="Mark of the Web">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83D;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind ZoneIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="All files (recommended)" />
                        <ComboBoxItem Content="Office documents only" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Description="Opens .tar.gz, .tar.xz and similar files straight into the TAR inside." Header="Open tarballs in one step">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B8;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.AutoOpenTarballs, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="Links that would point outside the destination are always kept as plain files." Header="Restore symbolic links">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE71B;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.RestoreSymbolicLinks, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>

                <!-- Creating -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Creating archives" />
                <tk:SettingsCard Header="Default format">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C3;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="FormatCombo" MinWidth="200" DisplayMemberPath="DisplayName" SelectionChanged="OnFormatChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Default compression level">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F5;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind LevelIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Store" />
                        <ComboBoxItem Content="Fastest" />
                        <ComboBoxItem Content="Fast" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Maximum" />
                        <ComboBoxItem Content="Ultra" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Encrypt file names by default (7z)">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.DefaultEncryptFileNames, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="Runs long compressions with Windows 11 efficiency mode (EcoQoS) so the PC stays quiet and responsive. Takes longer." Header="Efficiency mode for compression">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC0A;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.EfficiencyModeForBackground, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>

                <!-- Windows integration -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Windows integration" />
                <tk:SettingsExpander Description="Commands shown when you right-click files in File Explorer." Header="Context menu">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Open archive"><ToggleSwitch IsOn="{x:Bind S.MenuOpen, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Extract files…"><ToggleSwitch IsOn="{x:Bind S.MenuExtract, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Extract here"><ToggleSwitch IsOn="{x:Bind S.MenuExtractHere, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Extract to folder"><ToggleSwitch IsOn="{x:Bind S.MenuExtractSmart, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Test archive"><ToggleSwitch IsOn="{x:Bind S.MenuTest, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Add to archive…"><ToggleSwitch IsOn="{x:Bind S.MenuCompress, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Add to .7z"><ToggleSwitch IsOn="{x:Bind S.MenuCompress7z, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Add to .zip"><ToggleSwitch IsOn="{x:Bind S.MenuCompressZip, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Compress and share"><ToggleSwitch IsOn="{x:Bind S.MenuCompressShare, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Checksums"><ToggleSwitch IsOn="{x:Bind S.MenuHash, Mode=TwoWay}" Toggled="OnChanged" /></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsCard Click="OnDefaultAppsClick" Description="Choose which archive types open with 7-Zip in Windows Settings." Header="Default apps" IsClickEnabled="True">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7AC;" /></tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Description="When 7-Zip isn't in front, a notification tells you when an operation finishes." Header="Completion notifications">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.NotifyOnCompletion, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>

                <!-- Privacy & security -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Privacy and security" />
                <tk:SettingsCard Description="Passwords you choose to remember are kept in Windows Credential Manager and unlocked with Windows Hello." Header="Offer saved passwords">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="OnForgetPasswordsClick" Content="Forget all" />
                        <ToggleSwitch IsOn="{x:Bind S.OfferSavedPasswords, Mode=TwoWay}" Toggled="OnChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Confirm before deleting from archives">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind S.ConfirmDelete, Mode=TwoWay}" Toggled="OnChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="TempCard" Description="Files opened from archives are copied here and removed when 7-Zip closes." Header="Temporary files">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B8;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="TempSizeText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Click="OnCleanTempClick" Content="Clean up" />
                    </StackPanel>
                </tk:SettingsCard>

                <!-- About -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="About" />
                <tk:SettingsExpander x:Name="AboutExpander" Header="7-Zip for Windows 11">
                    <tk:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Square44x44Logo.targetsize-32.png" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard ContentAlignment="Left">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="VersionText" IsTextSelectionEnabled="True" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="7-Zip engine copyright © Igor Pavlov. Licensed under the GNU LGPL, with BSD-3-Clause parts and the unRAR license restriction (the RAR code may not be used to re-create the RAR compression algorithm)." />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <HyperlinkButton Content="7-zip.org" NavigateUri="https://www.7-zip.org/" />
                                    <HyperlinkButton Content="License" NavigateUri="https://www.7-zip.org/license.txt" />
                                </StackPanel>
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
