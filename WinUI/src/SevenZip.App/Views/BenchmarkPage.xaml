<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevenZip.App.Views.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SevenZip.App.Views"
    xmlns:bench="using:SevenZip.Core.Benchmark"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" Text="Benchmark" />

                <tk:SettingsCard Header="Dictionary size">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F5;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" ItemsSource="{x:Bind ViewModel.Dictionaries}" SelectedItem="{x:Bind ViewModel.SelectedDictionary, Mode=TwoWay}" IsEnabled="{x:Bind local:Converters.Not(ViewModel.IsRunning), Mode=OneWay}" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="CPU threads">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></tk:SettingsCard.HeaderIcon>
                    <Slider Width="220" Maximum="{x:Bind ViewModel.MaxThreads}" Minimum="1" StepFrequency="1" Value="{x:Bind ViewModel.Threads, Mode=TwoWay}" IsEnabled="{x:Bind local:Converters.Not(ViewModel.IsRunning), Mode=OneWay}" />
                </tk:SettingsCard>

                <Grid Margin="0,12,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Compressing" />
                        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.CompressSpeed, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Decompressing" />
                        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.DecompressSpeed, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.AverageText, Mode=OneWay}" TextWrapping="Wrap" />
                <InfoBar IsClosable="False" IsOpen="{x:Bind local:Converters.IsNotEmpty(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" />

                <Button x:Name="StartButton" MinWidth="120" Click="OnStartClick" Content="Start" Style="{StaticResource AccentButtonStyle}" />

                <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Passes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bench:BenchmarkPass">
                            <Grid Padding="0,6" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:BenchmarkPage.PassLabel(Pass)}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind local:BenchmarkPage.Speed(CompressMBps)}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind local:BenchmarkPage.Speed(DecompressMBps)}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind local:BenchmarkPage.RatioLabel(Ratio)}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
