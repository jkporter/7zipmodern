<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SevenZip.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SevenZip.App.ViewModels"
    Title="7-Zip">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Key="F4" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnNextTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="OnPreviousTabAccelerator" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewArchiveAccelerator" />
        </Grid.KeyboardAccelerators>

        <TabView
            x:Name="Tabs"
            AddTabButtonClick="OnAddTabClick"
            AllowDropTabs="False"
            CanDragTabs="True"
            CanReorderTabs="True"
            CloseButtonOverlayMode="OnPointerOver"
            IsAddTabButtonVisible="True"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <TabView.Resources>
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
            </TabView.Resources>

            <TabView.TabStripHeader>
                <Image
                    Width="16"
                    Height="16"
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-16.png" />
            </TabView.TabStripHeader>

            <TabView.TabStripFooter>
                <Grid x:Name="FooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="48" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DragRegion" Background="Transparent" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            x:Name="ActivityButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Padding="10,6"
                            AutomationProperties.Name="Activity"
                            ToolTipService.ToolTip="Activity">
                            <Grid>
                                <FontIcon FontSize="16" Glyph="&#xE823;" />
                                <ProgressRing
                                    x:Name="ActivityRing"
                                    Width="22"
                                    Height="22"
                                    Margin="-3"
                                    IsActive="False"
                                    IsIndeterminate="True" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Grid Width="380" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Activity" />
                                        <TextBlock
                                            x:Name="NoActivityText"
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Nothing is running. Extractions, tests and compressions appear here while they run."
                                            TextWrapping="Wrap" />
                                        <ListView
                                            x:Name="ActivityList"
                                            Grid.Row="1"
                                            MaxHeight="420"
                                            Margin="-12,0"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OperationViewModel">
                                                    <Grid Padding="0,8" ColumnSpacing="8" RowSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <ProgressBar Grid.Row="1" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" ShowPaused="{x:Bind IsPaused, Mode=OneWay}" Value="{x:Bind Percent, Mode=OneWay}" />
                                                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Stats, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind TogglePauseCommand}" Visibility="{x:Bind IsActive, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind PauseLabel, Mode=OneWay}">
                                                                <FontIcon FontSize="16" Glyph="{x:Bind PauseGlyph, Mode=OneWay}" />
                                                            </Button>
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind CancelCommand}" Visibility="{x:Bind IsActive, Mode=OneWay}" ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel">
                                                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                                                            </Button>
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind RevealCommand}" Visibility="{x:Bind IsFinished, Mode=OneWay}" ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer">
                                                                <FontIcon FontSize="16" Glyph="&#xED25;" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Padding="10,6"
                            AutomationProperties.AcceleratorKey="Ctrl+,"
                            AutomationProperties.Name="Settings"
                            Click="OnSettingsClick"
                            ToolTipService.ToolTip="Settings (Ctrl+,)">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </TabView.TabStripFooter>
        </TabView>
    </Grid>
</Window>
