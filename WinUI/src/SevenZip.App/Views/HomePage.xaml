<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevenZip.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SevenZip.App.Views"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,4">
                    <Image Width="48" Height="48" Source="ms-appx:///Assets/Square44x44Logo.targetsize-48.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="7-Zip" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Open, create and verify archives — 7z, ZIP, RAR, TAR, ISO and 50 more formats." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,24,0,0" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ActionTileStyle}" Click="OnOpenClick" AutomationProperties.Name="Open archive">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8E5;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Open archive" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Browse, extract and edit · Ctrl+O" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ActionTileStyle}" Click="OnCompressClick" AutomationProperties.Name="Create archive">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xF012;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Create archive" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Compress and encrypt files · Ctrl+N" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ActionTileStyle}" Click="OnHashClick" AutomationProperties.Name="Verify checksums">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Verify checksums" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SHA-256, CRC32, BLAKE2 and more" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ActionTileStyle}" Click="OnBenchmarkClick" AutomationProperties.Name="Benchmark">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xEC4A;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Benchmark" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Measure compression speed" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    x:Name="DropZone"
                    Margin="0,12,0,0"
                    Padding="24"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE896;" />
                        <TextBlock x:Name="DropText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drop archives here to open them, or other files to compress them" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,28,0,6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="ClearRecentButton" HorizontalAlignment="Right" Click="OnClearRecentClick" Content="Clear list" />
                </Grid>
                <TextBlock x:Name="EmptyRecentText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Archives you open appear here and in the taskbar jump list." Visibility="Collapsed" />
                <ListView
                    x:Name="RecentList"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecentClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RecentItem">
                            <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnRecentShowInFolder" Text="Show in folder" Tag="{x:Bind Path}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED25;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnRecentRemove" Text="Remove from list" Tag="{x:Bind Path}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="{x:Bind Icon}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind When}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
