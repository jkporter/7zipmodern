<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevenZip.App.Views.ExtractOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="440" MaxWidth="560" Spacing="14">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Destination" Text="{x:Bind Model.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseClick" Content="Browse…" />
        </Grid>

        <CheckBox Content="{x:Bind Model.SubfolderLabel}" IsChecked="{x:Bind Model.CreateSubfolder, Mode=TwoWay}" />

        <PasswordBox
            Header="Password"
            Password="{x:Bind Model.Password, Mode=TwoWay}"
            PasswordRevealMode="Peek"
            PlaceholderText="Required for encrypted files"
            Visibility="{x:Bind Model.NeedsPassword, Mode=OneWay}" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" Header="When a file already exists" SelectedIndex="{x:Bind Model.OverwriteIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Ask me" />
                <ComboBoxItem Content="Replace it" />
                <ComboBoxItem Content="Skip it" />
                <ComboBoxItem Content="Keep both" />
                <ComboBoxItem Content="Rename the existing file" />
            </ComboBox>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Header="Folders" SelectedIndex="{x:Bind Model.PathModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Keep folder structure" />
                <ComboBoxItem Content="Put all files in one folder" />
            </ComboBox>
        </Grid>

        <CheckBox Content="Show the files in File Explorer when done" IsChecked="{x:Bind Model.OpenFolderWhenDone, Mode=TwoWay}" />

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="More options">
            <StackPanel Spacing="12">
                <ComboBox HorizontalAlignment="Stretch" Header="Mark of the Web (security zone from the download)" SelectedIndex="{x:Bind Model.ZoneIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Don't apply" />
                    <ComboBoxItem Content="Apply to all extracted files (recommended)" />
                    <ComboBoxItem Content="Apply to Office documents only" />
                </ComboBox>
                <CheckBox Content="Restore file dates" IsChecked="{x:Bind Model.RestoreTimestamps, Mode=TwoWay}" />
                <CheckBox Content="Restore symbolic links (only inside the destination)" IsChecked="{x:Bind Model.RestoreSymbolicLinks, Mode=TwoWay}" />
            </StackPanel>
        </Expander>

        <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" />
    </StackPanel>
</UserControl>
