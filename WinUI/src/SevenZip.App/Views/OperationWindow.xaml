<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SevenZip.App.Views.OperationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="7-Zip">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleArea" Padding="12,0,140,0" ColumnSpacing="10" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/Square44x44Logo.targetsize-16.png" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="7-Zip" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,8,24,12" Spacing="10">
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />

            <ContentPresenter x:Name="OptionsHost" Visibility="Collapsed" />

            <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="DetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" />
                <TextBlock x:Name="StatsText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <InfoBar x:Name="ResultBar" IsClosable="False" />
            <ListView x:Name="MessageList" MaxHeight="180" SelectionMode="None" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="EfficiencyToggle"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Efficiency mode"
                    Click="OnEfficiencyClick"
                    ToolTipService.ToolTip="Efficiency mode: run quietly in the background (slower)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xEC0A;" />
                        <TextBlock Text="Efficiency" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SecondaryButton" Grid.Column="1" MinWidth="96" Click="OnSecondaryClick" />
                <Button x:Name="PrimaryButton" Grid.Column="2" MinWidth="96" Click="OnPrimaryClick" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
