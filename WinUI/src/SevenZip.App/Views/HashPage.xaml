<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevenZip.App.Views.HashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SevenZip.App.Views"
    xmlns:vm="using:SevenZip.App.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Checksums" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Compute file checksums with the 7-Zip engine, then paste a published checksum to verify a download." TextWrapping="Wrap" />

                <Grid Padding="16" ColumnSpacing="12" RowSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceItem">
                                <StackPanel Margin="0,2" Orientation="Horizontal" Spacing="10">
                                    <Image Width="20" Height="20" Source="{x:Bind Icon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drop files or folders here, or choose them." Visibility="{x:Bind local:Converters.VisibleIfZero(ViewModel.Sources.Count), Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Click="OnAddFilesClick" Content="Add files" />
                        <Button Click="OnClearClick" Content="Clear" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Algorithms" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Algorithms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlgorithmOption">
                                    <ToggleButton Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnComputeClick" IsEnabled="{x:Bind local:Converters.Not(ViewModel.IsWorking), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
                                <TextBlock Text="Compute" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnCopyAllClick" Content="Copy all" IsEnabled="{x:Bind local:Converters.HasAny(ViewModel.Results.Count), Mode=OneWay}" />
                        <Button Click="OnExportClick" Content="Save checksum file…" />
                    </StackPanel>
                </Grid>

                <AutoSuggestBox
                    Header="Verify"
                    PlaceholderText="Paste the expected checksum (any algorithm)"
                    QueryIcon="Paste"
                    QuerySubmitted="OnPasteQuery"
                    Text="{x:Bind ViewModel.Expected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <InfoBar
                    x:Name="VerifyBar"
                    IsClosable="False"
                    IsOpen="{x:Bind local:Converters.IsNotEmpty(ViewModel.VerifyText), Mode=OneWay}"
                    Message="{x:Bind ViewModel.VerifyText, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileHashViewModel">
                            <StackPanel Margin="0,0,0,8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Spacing="6">
                                <Grid>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SizeText}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Digests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DigestRow">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Algorithm}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                                <FontIcon Grid.Column="2" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" Visibility="{x:Bind MatchVisibility, Mode=OneWay}" />
                                                <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Copy" Click="OnCopyDigestClick" Tag="{x:Bind Value}" ToolTipService.ToolTip="Copy">
                                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
