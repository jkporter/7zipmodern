<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SevenZip.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- The engine is native x64/ARM64 only; Windows 11 has no 32-bit-only hardware. -->
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SevenZip.Core.Tests" />
  </ItemGroup>

</Project>
