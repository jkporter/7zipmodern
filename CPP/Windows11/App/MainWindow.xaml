<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the main window (CMainWindow in MainWindow.cpp creates the Window and attaches the handlers). -->
<Grid
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TabView
        x:Name="Tabs"
        AllowDropTabs="False"
        CanDragTabs="True"
        CanReorderTabs="True"
        CloseButtonOverlayMode="OnPointerOver"
        IsAddTabButtonVisible="True"
        TabWidthMode="SizeToContent"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <TabView.Resources>
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
            <!-- The caption buttons are Tall (48 px, MainWindow.cpp): 8 px header padding + 40 px tabs make the strip
                 as tall as they are, as in File Explorer. With the default 32 px tabs they hang below the strip. -->
            <x:Double x:Key="TabViewItemMinHeight">40</x:Double>
            <!-- Tabs stretch their content (for the page), which also stretches the header; this keeps its text centered. -->
            <DataTemplate x:Key="TabHeaderTemplate">
                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
            </DataTemplate>
        </TabView.Resources>

        <TabView.TabStripHeader>
            <Image
                Width="16"
                Height="16"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-16.png" />
        </TabView.TabStripHeader>

        <TabView.TabStripFooter>
            <Grid x:Name="FooterGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CaptionSpacer" Width="140" />
                </Grid.ColumnDefinitions>
                <Border x:Name="DragRegion" Background="Transparent" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button
                        x:Name="ActivityButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="10,6"
                        AutomationProperties.Name="Activity"
                        ToolTipService.ToolTip="Activity">
                        <Grid>
                            <FontIcon FontSize="16" Glyph="&#xE823;" />
                            <ProgressRing
                                x:Name="ActivityRing"
                                Width="22"
                                Height="22"
                                Margin="-3"
                                IsActive="False"
                                IsIndeterminate="True" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Grid Width="380" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Activity" />
                                    <TextBlock
                                        x:Name="NoActivityText"
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Nothing is running. Extractions, tests and compressions appear here while they run."
                                        TextWrapping="Wrap" />
                                    <ListView
                                        x:Name="ActivityList"
                                        Grid.Row="1"
                                        MaxHeight="420"
                                        Margin="-12,0"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,8" ColumnSpacing="8" RowSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsIndeterminate}" ShowPaused="{Binding IsPaused}" Value="{Binding Percent}" />
                                                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Stats}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding TogglePauseCommand}" Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}" ToolTipService.ToolTip="{Binding PauseLabel}" AutomationProperties.Name="{Binding PauseLabel}">
                                                            <FontIcon FontSize="16" Glyph="{Binding PauseGlyph}" />
                                                        </Button>
                                                        <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding CancelCommand}" Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}" ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel">
                                                            <FontIcon FontSize="16" Glyph="&#xE711;" />
                                                        </Button>
                                                        <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding RevealCommand}" Visibility="{Binding IsFinished, Converter={StaticResource VisibleIf}}" ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer">
                                                            <FontIcon FontSize="16" Glyph="&#xED25;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="10,6"
                        AutomationProperties.AcceleratorKey="Ctrl+,"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </TabView.TabStripFooter>
    </TabView>
</Grid>
