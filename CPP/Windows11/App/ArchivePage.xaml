<?xml version="1.0" encoding="utf-8"?>
<!--
    Archive browser (CArchivePage). DataContext = CArchiveViewModel.
    Handlers and keyboard accelerators with handlers are attached in ArchivePage.cpp by x:Name.
    The list column widths are bound from code (CArchivePage::ApplyColumnBindings).
-->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="8,4,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                x:Name="Toolbar"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsEnabled="{Binding IsLoading, Converter={StaticResource Not}}">
                <AppBarButton AccessKey="E" AutomationProperties.AcceleratorKey="Ctrl+E" Label="Extract" ToolTipService.ToolTip="Extract (Ctrl+E)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="ExtractToItem" Text="Extract to…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExtractSmartItem" Text="Extract to folder">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExtractHereItem" Text="Extract here">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton AccessKey="A" Label="Add" IsEnabled="{Binding CanModify}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="AddFilesItem" Text="Add files…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddFolderItem" Text="Add folder…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="NewFolderItem" Text="New folder">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="RenameButton" AccessKey="M" AutomationProperties.AcceleratorKey="F2" IsEnabled="False" Label="Rename" ToolTipService.ToolTip="Rename (F2)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" AccessKey="D" AutomationProperties.AcceleratorKey="Delete" IsEnabled="False" Label="Delete" ToolTipService.ToolTip="Delete (Del)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ShareButton" AccessKey="S" Label="Share" ToolTipService.ToolTip="Share with the Windows Share sheet">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="TestButton" AccessKey="T" Label="Test" ToolTipService.ToolTip="Check the archive for errors">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarToggleButton x:Name="DetailsToggle" AccessKey="P" Label="Details" ToolTipService.ToolTip="Details pane (Alt+Enter)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE89F;" /></AppBarToggleButton.Icon>
                    <AppBarToggleButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Menu" />
                    </AppBarToggleButton.KeyboardAccelerators>
                </AppBarToggleButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="RevealArchiveButton" Label="Show archive in File Explorer">
                        <AppBarButton.Icon><FontIcon Glyph="&#xED25;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="CopyPathButton" Label="Copy archive path">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="HashArchiveButton" Label="Checksums of archive file">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton x:Name="RefreshButton" Label="Refresh">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="260"
                VerticalAlignment="Center"
                AutomationProperties.LandmarkType="Search"
                AutomationProperties.Name="Search this archive"
                PlaceholderText="Search this archive"
                QueryIcon="Find"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="4" AutomationProperties.LandmarkType="Navigation" AutomationProperties.Name="Location">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="UpButton"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.AcceleratorKey="Alt+Up"
                AutomationProperties.Name="Up one level"
                IsEnabled="{Binding CanGoUp}"
                ToolTipService.ToolTip="Up (Alt+Up)">
                <FontIcon FontSize="16" Glyph="&#xE74A;" />
            </Button>
            <BreadcrumbBar
                x:Name="Breadcrumbs"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                ItemsSource="{Binding Breadcrumbs}" />
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Padding="12,0,12,4" Spacing="4">
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasLoadError}"
                Message="{Binding LoadError}"
                Severity="Error"
                Title="Can't open this archive">
                <InfoBar.ActionButton>
                    <Button x:Name="RetryButton" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsOpen="{Binding HasWarning}"
                Message="{Binding Warning}"
                Severity="Warning" />
            <ItemsControl ItemsSource="{Binding PendingEdits}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <InfoBar IsClosable="False" IsOpen="True" Margin="0,0,0,4" Severity="Informational" Title="{Binding ArchivePath}" Message="was changed in another app. Update the copy in the archive?">
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding ApplyCommand}" Content="Update archive" Style="{StaticResource AccentButtonStyle}" />
                                <Button Command="{Binding DiscardCommand}" Content="Discard" />
                            </StackPanel>
                        </InfoBar>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="3" Padding="12,0,12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Archive contents">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Grid x:Name="ColumnHeader" Padding="12,4,16,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SortNameButton" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="{Binding NameSortLabel}" Tag="Name">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Name" />
                            <FontIcon FontSize="10" Glyph="{Binding NameSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortModifiedButton" Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="{Binding ModifiedSortLabel}" Tag="Modified">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Date modified" />
                            <FontIcon FontSize="10" Glyph="{Binding ModifiedSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortTypeButton" Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="{Binding TypeSortLabel}" Tag="Type">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Type" />
                            <FontIcon FontSize="10" Glyph="{Binding TypeSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortSizeButton" Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="{Binding SizeSortLabel}" Tag="Size">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Size" />
                            <FontIcon FontSize="10" Glyph="{Binding SizeSortGlyph}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortPackedButton" Grid.Column="4" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="{Binding PackedSortLabel}" Tag="Packed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Packed" />
                            <FontIcon FontSize="10" Glyph="{Binding PackedSortGlyph}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    x:Name="ItemsList"
                    Grid.Row="1"
                    Padding="0,4"
                    AllowDrop="False"
                    CanDragItems="True"
                    IsItemClickEnabled="False"
                    ItemsSource="{Binding Items}"
                    SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="ItemMenu">
                            <MenuFlyoutItem x:Name="MenuOpen" Text="Open" FontWeight="SemiBold" KeyboardAcceleratorTextOverride="Enter">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuOpenWith" Text="Open with…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AC;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuOpenInside" Text="Open as archive">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuExtract" Text="Extract to…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuCopy" Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuShare" Text="Share">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuRename" Text="Rename" KeyboardAcceleratorTextOverride="F2">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuDelete" Text="Delete" KeyboardAcceleratorTextOverride="Del">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuProperties" Text="Properties" KeyboardAcceleratorTextOverride="Alt+Enter">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" />
                                        <FontIcon
                                            Margin="0,0,-4,-4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="10"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE72E;"
                                            Visibility="{Binding IsEncrypted, Converter={StaticResource VisibleIf}}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{ThemeResource ListCaptionTextStyle}" Text="{Binding Location}" Visibility="{Binding Location, Converter={StaticResource VisibleIfNotEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{ThemeResource CellTextStyle}" Text="{Binding ModifiedText}" />
                                <TextBlock Grid.Column="2" Style="{ThemeResource CellTextStyle}" Text="{Binding TypeName}" />
                                <TextBlock Grid.Column="3" Style="{ThemeResource CellTextStyle}" HorizontalTextAlignment="Right" Text="{Binding SizeText}" />
                                <TextBlock Grid.Column="4" Style="{ThemeResource CellTextStyle}" HorizontalTextAlignment="Right" Text="{Binding PackedText}" ToolTipService.ToolTip="{Binding RatioText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing Grid.Row="1" Width="40" Height="40" IsActive="{Binding IsLoading}" />
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EmptyText}"
                    Visibility="{Binding EmptyVisible, Converter={StaticResource VisibleIf}}" />
            </Grid>

            <!-- Details pane -->
            <ScrollViewer x:Name="DetailsPane" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,8,4,16" Spacing="12">
                    <Image Width="48" Height="48" HorizontalAlignment="Left" Source="{Binding DetailsIcon}" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding DetailsTitle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Name}" />
                                    <TextBlock IsTextSelectionEnabled="True" Text="{Binding Value}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectionText}" />
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                ToolTipService.ToolTip="{Binding ReadOnlyReason}"
                Visibility="{Binding ReadOnlyVisible, Converter={StaticResource VisibleIf}}">
                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE72E;" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Read-only" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
