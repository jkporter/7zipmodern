<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 uap10 desktop desktop4 desktop5 com rescap">

  <Identity Name="7-Zip.WinUI" Publisher="CN=7-Zip WinUI Developer" Version="26.4.0.0" />

  <Properties>
    <DisplayName>7-Zip</DisplayName>
    <PublisherDisplayName>7-Zip WinUI contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Open, create and verify archives with the 7-Zip engine, designed for Windows 11.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- Windows App SDK runtime (framework package), the version App/makefile builds against -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.5.1.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="SevenZip.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="7-Zip"
        Description="Open, create and verify archives"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Double-click to open. Explorer verbs come from the IExplorerCommand handler below. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="archive">
            <uap:DisplayName>Archive</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:InfoTip>Archive (opens with 7-Zip)</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.zst</uap:FileType>
              <uap:FileType>.lzma</uap:FileType>
              <uap:FileType>.lz</uap:FileType>
              <uap:FileType>.z</uap:FileType>
              <uap:FileType>.cab</uap:FileType>
              <uap:FileType>.arj</uap:FileType>
              <uap:FileType>.lzh</uap:FileType>
              <uap:FileType>.cpio</uap:FileType>
              <uap:FileType>.rpm</uap:FileType>
              <uap:FileType>.deb</uap:FileType>
              <uap:FileType>.001</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="diskimage">
            <uap:DisplayName>Disk image</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.iso</uap:FileType>
              <uap:FileType>.wim</uap:FileType>
              <uap:FileType>.vhd</uap:FileType>
              <uap:FileType>.vhdx</uap:FileType>
              <uap:FileType>.vmdk</uap:FileType>
              <uap:FileType>.dmg</uap:FileType>
              <uap:FileType>.squashfs</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!-- `7zw` on the command line / Run box. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="SevenZip.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="7zw.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!-- Receive files from other apps' Share sheet and compress them. -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Compress with 7-Zip">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- Windows 11 File Explorer context menu (top level, not "Show more options"). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SevenZip" Clsid="AB1904A6-9AFE-48AE-8A8C-B605FD3135F5" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SevenZip" Clsid="AB1904A6-9AFE-48AE-8A8C-B605FD3135F5" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="7-Zip File Explorer integration">
              <com:Class Id="AB1904A6-9AFE-48AE-8A8C-B605FD3135F5" Path="SevenZip.ShellExtension.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Clicking a completion notification ("Show in folder") activates the app. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="0A18765E-29E5-4906-8BD3-E848057DEF9A" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="SevenZip.exe" DisplayName="7-Zip" Arguments="----AppNotificationActivated:">
              <com:Class Id="0A18765E-29E5-4906-8BD3-E848057DEF9A" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
